# ==========================================
# INGRESS MODE
#   local  — dashboard only, no public URLs (default)
#   direct — public IP + Let's Encrypt; works with sslip.io
#   tunnel — Cloudflare Tunnel (real domain required)
# ==========================================
INGRESS_MODE=local

# ==========================================
# DOMAIN
#   local  : localhost                            (default)
#   direct : <public-ip>.sslip.io   ← auto-filled by setup.sh when empty
#            or yourdomain.com      (if you own one)
#   tunnel : yourdomain.com
#
# sslip.io is a free public DNS service: any subdomain of
# <ip>.sslip.io resolves to <ip>. No signup, no card.
# ==========================================
MAIN_DOMAIN=localhost

# APP_URL is derived by setup.sh. Leave empty to auto-compute.
APP_URL=

# Ports. In direct mode HTTP_PORT must be 80 (ACME HTTP-01).
API_PORT=8080
HTTP_PORT=8000
HTTPS_PORT=443
BIND_ADDR=127.0.0.1

# ==========================================
# AUTH  (local | github | both)
# ==========================================
AUTH_METHOD=local
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ==========================================
# DATABASE
# ==========================================
DB_USER=paas
DB_PASSWORD=
DB_NAME=paas_db

# ==========================================
# SECRETS (setup.sh fills these)
# ==========================================
JWT_SECRET=

# ==========================================
# TLS — only used when INGRESS_MODE=direct
#   Leave ACME_DNS_PROVIDER empty for HTTP-01 (required for sslip.io).
#   Set to a lego provider name only if you own a real domain and need
#   wildcard certs (e.g. cloudflare, route53, digitalocean).
# ==========================================
ACME_EMAIL=
ACME_DNS_PROVIDER=
ACME_DNS_API_TOKEN=

# ==========================================
# Tunnel — only used when INGRESS_MODE=tunnel
#   Get the token on the host that created the tunnel:
#     cloudflared tunnel token <name>
#   Do NOT use sslip.io with tunnel mode — Cloudflare controls DNS.
# ==========================================
CLOUDFLARE_TUNNEL_TOKEN=

# ==========================================
# Per-app DNS (optional)
# ==========================================
DNS_PROVIDER=none
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=