# ---- Server ----
PORT=8080
APP_ENV=development            # development | production
LOG_LEVEL=info
MAIN_DOMAIN=domainanda.com
SERVER_IP=127.0.0.1
DOCKER_HOST=unix:///var/run/docker.sock

# ---- Cloudflare ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_NAME=kelas-a-tunnel
# Token tunnel (Zero Trust > Networks > Tunnels) untuk container cloudflared di docker-compose
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Workspace ----
WORKSPACE_PATH=./data/workspace
DATA_PATH=./data

# ---- PostgreSQL (database platform) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=paas
DB_PASSWORD=ganti-password-kuat
DB_NAME=paas_db
DB_SSLMODE=disable

# ---- GitHub OAuth App (https://github.com/settings/developers) ----
# Authorization callback URL = GITHUB_REDIRECT_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Secret acak untuk memverifikasi webhook (openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=
# URL publik backend; dipakai untuk mendaftarkan webhook otomatis ke repo user
GITHUB_WEBHOOK_BASE_URL=https://api.domainanda.com
# Default: <GITHUB_WEBHOOK_BASE_URL>/api/auth/github/callback
GITHUB_REDIRECT_URL=
# Tujuan redirect setelah login (frontend)
FRONTEND_URL=http://localhost:5173

# ---- Security ----
# Menandatangani session & mengenkripsi access token GitHub di DB (openssl rand -hex 32)
JWT_SECRET=ganti-dengan-random-panjang
SESSION_TTL_HOURS=168
# Origin frontend yang diizinkan (koma), atau * untuk development
CORS_ORIGINS=*

# ---- Worker / Build ----
WORKER_COUNT=2
QUEUE_SIZE=64
BUILDER_IMAGE=paketobuildpacks/builder-jammy-base:latest

# ---- Traefik ----
# false: TLS diterminasi di Cloudflare (tunnel -> entrypoint web). true: Traefik + ACME DNS-01.
TRAEFIK_TLS=false
TRAEFIK_CERT_RESOLVER=cloudflare
