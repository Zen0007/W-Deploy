# ═══════════════════════════════════════════════════════════
# W-DEPLOY · Konfigurasi Minimal
# Cukup isi 2 baris di bawah ini, sisanya otomatis.
# ═══════════════════════════════════════════════════════════

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════
# OPSIONAL — biarkan kosong untuk auto-detect / auto-generate
# ═══════════════════════════════════════════════════════════

# Auto-detect dari Host header saat ada request. Kosongkan untuk mode lokal (nip.io)
# MAIN_DOMAIN=

# Auto-generate di boot pertama (disimpan ke .env)
# JWT_SECRET=
# DB_PASSWORD=

# Auto-generate: whsec_<random 32 hex>
# GITHUB_WEBHOOK_SECRET=

# Opsional — hanya jika mau pakai Cloudflare Tunnel. Kosongkan = pakai Traefik direct
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_TUNNEL_ID=

# Default production-ready (tidak perlu diubah)
PORT=8080
APP_ENV=production
DB_HOST=postgres
DB_PORT=5432
DB_USER=paas
DB_NAME=paas_db
WORKER_COUNT=2
QUEUE_SIZE=64
TRAEFIK_TLS=false